  "cards": [
    { "dot": "cyan", "title": "OIDC PKCE", "items": ["Same PKCE S256 mechanics as GitHub", "scope=openid email profile requests a real id_token"] },
    { "dot": "rose", "title": "Real Nonce Verification", "items": ["nonce is its own param, separate from state", "id_token's nonce claim is checked after token exchange", "Google signs the id_token — this nonce check is real"] },
